# ==============================
# SmartNumber AI - .gitignore
# ==============================

# Virtual Environment
venv/
env/
.venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Environment variables / secrets
.env
.env.*
!.env.example

# Uploaded files
uploads/*
!uploads/.gitkeep

# Generated database
database/*.db
database/*.sqlite
database/*.sqlite3

# Trained ML models
# Uncomment if you DON'T want to upload models to GitHub
# model/*.keras
# model/*.h5
# model/*.hdf5

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Build / distribution
build/
dist/
*.egg-info/

# Node (if we later use npm)
node_modules/

# Local configuration
config.local.*